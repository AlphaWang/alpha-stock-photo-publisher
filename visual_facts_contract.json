{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock photo visual facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary_subjects_en",
    "primary_subjects_zh",
    "required_terms_en",
    "required_terms_zh",
    "forbidden_claims_en",
    "forbidden_claims_zh",
    "water_visible",
    "trail_visible",
    "people_visible",
    "recognizable_people_visible",
    "structures_visible",
    "vehicles_visible",
    "animals_visible",
    "reflection_visible",
    "text_visible",
    "logo_or_trademark_visible",
    "copyrighted_content_visible",
    "private_property_visible",
    "copy_space_visible",
    "scene_signature",
    "burst_group_id",
    "burst_rank",
    "technical_quality",
    "commercial_potential",
    "commercial_strengths_en",
    "selection_status",
    "uncertain_details"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "primary_subjects_en": {"$ref": "#/$defs/nonEmptyStrings"},
    "primary_subjects_zh": {"$ref": "#/$defs/nonEmptyStrings"},
    "required_terms_en": {"$ref": "#/$defs/strings"},
    "required_terms_zh": {"$ref": "#/$defs/strings"},
    "forbidden_claims_en": {"$ref": "#/$defs/strings"},
    "forbidden_claims_zh": {"$ref": "#/$defs/strings"},
    "water_visible": {"$ref": "#/$defs/observation"},
    "trail_visible": {"$ref": "#/$defs/observation"},
    "people_visible": {"$ref": "#/$defs/observation"},
    "recognizable_people_visible": {"$ref": "#/$defs/observation"},
    "structures_visible": {"$ref": "#/$defs/observation"},
    "vehicles_visible": {"$ref": "#/$defs/observation"},
    "animals_visible": {"$ref": "#/$defs/observation"},
    "reflection_visible": {"$ref": "#/$defs/observation"},
    "text_visible": {"$ref": "#/$defs/observation"},
    "logo_or_trademark_visible": {"$ref": "#/$defs/observation"},
    "copyrighted_content_visible": {"$ref": "#/$defs/observation"},
    "private_property_visible": {"$ref": "#/$defs/observation"},
    "copy_space_visible": {"$ref": "#/$defs/observation"},
    "scene_signature": {"type": "string", "minLength": 1},
    "burst_group_id": {"type": "string"},
    "burst_rank": {"type": "integer", "minimum": 0},
    "technical_quality": {"const": "pass"},
    "commercial_potential": {"enum": ["high", "medium"]},
    "commercial_strengths_en": {"$ref": "#/$defs/nonEmptyStrings"},
    "selection_status": {"const": "selected"},
    "uncertain_details": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "observation": {"enum": ["yes", "no", "unknown"]},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
