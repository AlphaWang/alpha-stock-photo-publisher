{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StockPhotoMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title_en",
    "title_zh",
    "description_en",
    "description_zh",
    "keywords_en",
    "keywords_zh",
    "category1",
    "category2",
    "platform_categories",
    "location_en",
    "location_zh",
    "location_source",
    "location_confidence",
    "core_keywords_zh",
    "commercial_uses_en",
    "editorial_caption_en",
    "editorial_date",
    "editorial_location_en",
    "model_release_status",
    "property_release_status",
    "logo_trademark_status",
    "copyrighted_content_status",
    "commercial_eligibility",
    "release_status",
    "release_notes"
  ],
  "properties": {
    "title_en": {"type": "string", "minLength": 1, "maxLength": 70},
    "title_zh": {"type": "string", "minLength": 1, "maxLength": 50},
    "description_en": {"type": "string", "minLength": 5, "maxLength": 2048},
    "description_zh": {"type": "string", "minLength": 1, "maxLength": 50},
    "keywords_en": {
      "type": "array",
      "minItems": 7,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "keywords_zh": {
      "type": "array",
      "minItems": 5,
      "maxItems": 35,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "category1": {
      "enum": [
        "Abstract", "Animals/Wildlife", "Arts", "Backgrounds/Textures",
        "Beauty/Fashion", "Buildings/Landmarks", "Business/Finance", "Celebrities",
        "Education", "Food and drink", "Healthcare/Medical", "Holidays",
        "Industrial", "Interiors", "Miscellaneous", "Nature", "Objects",
        "Parks/Outdoor", "People", "Religion", "Science", "Signs/Symbols",
        "Sports/Recreation", "Technology", "Transportation", "Vintage"
      ]
    },
    "category2": {
      "enum": [
        "", "Abstract", "Animals/Wildlife", "Arts", "Backgrounds/Textures",
        "Beauty/Fashion", "Buildings/Landmarks", "Business/Finance", "Celebrities",
        "Education", "Food and drink", "Healthcare/Medical", "Holidays",
        "Industrial", "Interiors", "Miscellaneous", "Nature", "Objects",
        "Parks/Outdoor", "People", "Religion", "Science", "Signs/Symbols",
        "Sports/Recreation", "Technology", "Transportation", "Vintage"
      ]
    },
    "platform_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shutterstock", "adobestock", "tuchong", "istock"],
      "properties": {
        "shutterstock": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Abstract", "Animals/Wildlife", "Arts", "Backgrounds/Textures",
              "Beauty/Fashion", "Buildings/Landmarks", "Business/Finance", "Celebrities",
              "Education", "Food and drink", "Healthcare/Medical", "Holidays",
              "Industrial", "Interiors", "Miscellaneous", "Nature", "Objects",
              "Parks/Outdoor", "People", "Religion", "Science", "Signs/Symbols",
              "Sports/Recreation", "Technology", "Transportation", "Vintage"
            ]
          }
        },
        "adobestock": {
          "enum": [
            "", "Animals", "Buildings and Architecture", "Business",
            "Culture and Religion", "Food", "Graphic Resources",
            "Hobbies and Leisure", "Industry", "Landscapes", "Lifestyle", "People",
            "Plants and Flowers", "Science", "Social Issues", "Sports",
            "States of Mind", "Technology", "The Environment", "Transport", "Travel"
          ]
        },
        "tuchong": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "自然风光", "城市风光", "野生动物", "静物美食", "生活方式",
              "运动健康", "生物医疗", "节日假日", "商务肖像"
            ]
          }
        },
        "istock": {
          "enum": [
            "", "Nature", "Travel", "Buildings & Architecture", "Animals/Wildlife",
            "Food and Drink", "People", "Sports", "Healthcare & Medical", "Holidays",
            "Business", "Transport", "Technology"
          ]
        }
      }
    },
    "location_en": {"type": "string", "maxLength": 80},
    "location_zh": {"type": "string", "maxLength": 80},
    "location_source": {
      "enum": ["unknown", "context", "exif", "manual", "visible_landmark"]
    },
    "location_confidence": {"enum": ["unknown", "low", "medium", "high"]},
    "core_keywords_zh": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "commercial_uses_en": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "editorial_caption_en": {"type": "string", "maxLength": 2048},
    "editorial_date": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "editorial_location_en": {"type": "string", "maxLength": 120},
    "model_release_status": {
      "enum": ["not_required", "required", "provided", "unknown"]
    },
    "property_release_status": {
      "enum": ["not_required", "required", "provided", "unknown"]
    },
    "logo_trademark_status": {"enum": ["none", "visible", "unknown"]},
    "copyrighted_content_status": {"enum": ["none", "visible", "unknown"]},
    "commercial_eligibility": {"enum": ["clear", "review", "editorial_only"]},
    "release_status": {"enum": ["clear", "required", "unknown"]},
    "release_notes": {"type": "string", "maxLength": 240}
  }
}
